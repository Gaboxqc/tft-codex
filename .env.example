# Copy to .env and fill in. `.env` is gitignored — Riot API keys never enter the
# repo or any client bundle (design.md §10).

# ─── Riot API ────────────────────────────────────────────────────────────────
# Development keys expire every 24h. A production key application should be
# underway well before Phase 5 (see docs/approvals.md).
RIOT_API_KEY=RGAPI-your-development-key-here
# Regional routing for match-v1: americas | europe | asia | sea
RIOT_REGIONAL_ROUTE=europe
# Platform routing for league-v1/summoner-v1: euw1 | na1 | kr | ...
RIOT_PLATFORM_ROUTE=euw1
# Requests/second and burst allowed for this key tier (R12.2). Development keys
# are 20 req/s and 100 req/2min; set these to match whatever key you hold.
RIOT_RATE_LIMIT_PER_SECOND=20
RIOT_RATE_LIMIT_PER_TWO_MINUTES=100

# ─── Datastores ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://tftcodex:tftcodex@localhost:5432/tftcodex
REDIS_URL=redis://localhost:6379
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=tftcodex
# Full-access credentials — used by the aggregation job only.
CLICKHOUSE_USER=tftcodex
CLICKHOUSE_PASSWORD=tftcodex
# Restricted credentials for the API gateway. This user is GRANT-denied on
# augment_internal_stats so the public API is structurally unable to read it
# (design.md §7). Do not "temporarily" swap this to the admin user.
CLICKHOUSE_GATEWAY_USER=tftcodex_gateway
CLICKHOUSE_GATEWAY_PASSWORD=tftcodex_gateway

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
# Short-lived session JWTs (design.md §10). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-every-environment

# ─── Riot Sign-On (RSO) ──────────────────────────────────────────────────────
# Issued once Riot's third-party application is approved (docs/approvals.md).
RSO_CLIENT_ID=
RSO_CLIENT_SECRET=
RSO_REDIRECT_URI=http://localhost:4000/v1/auth/riot/callback

# ─── Compliance flags ────────────────────────────────────────────────────────
# R3.7 — Tier-3 adaptive (board-state-reactive) recommendations. This MUST stay
# false until written confirmation from Riot's third-party approval process is
# on file (docs/approvals.md). It is a server-side kill switch on purpose: no
# client build can enable Tier-3 by itself. Flipping this without the written
# answer is a compliance incident, not a config change.
RIOT_TIER3_RECOMMENDATIONS_CONFIRMED=false
# Path/reference to the confirmation record, for the audit trail.
RIOT_TIER3_CONFIRMATION_REF=

# ─── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── Editorial and summary drafting (tasks 6.1, 6.2) ─────────────────────────

# Shared secret for /v1/editorial/*. Unset means those routes 503 — closed by
# default, because a guard that falls open when unconfigured is not a guard.
# Generate with: openssl rand -base64 32
EDITORIAL_API_TOKEN=

# Drafts the per-patch meta summary. Optional: without it the drafting step
# no-ops and the summary stays unwritten, which the patch page already renders
# as "still being reviewed" (R8.2). A draft is never published without a human.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── Notification delivery (task 6.6) ────────────────────────────────────────

# This API's own public base URL. The email verification link lands on an API
# route rather than a web page, so it cannot be built from WEB_BASE_URL.
API_PUBLIC_URL=http://localhost:4000

# Web push. Free and self-generated — no vendor:
#   npx web-push generate-vapid-keys
# Both keys or neither; half a pair fails at send time with an opaque error.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com

# Email. Needs a provider key and a verified sending identity; both or neither.
# The sending domain's SPF/DKIM records are the real lead-time item here.
RESEND_API_KEY=
EMAIL_FROM=
