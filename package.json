{
  "name": "tft-codex",
  "private": true,
  "version": "0.0.0",
  "description": "TFT Codex — a data-backed Teamfight Tactics meta engine (web + Overwolf companion)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "~5.9",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.7"
  }
}
